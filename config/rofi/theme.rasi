/* Areej's Rofi theme — pink & green */

* {
    bg:         #1e1b2e;
    bg-alt:     #2d2b3d;
    fg:         #f8f8f2;
    pink:       #f48fb1;
    hot-pink:   #e91e8c;
    green:      #a8d8a8;
    muted:      #888888;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            440px;
    padding:          14px;
    border:           2px solid;
    border-radius:    14px;
    border-color:     @pink;
    background-color: @bg;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          10px;
}

/* ── Search bar ─────────────────────────────── */
inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          8px 12px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt {
    text-color: @pink;
    font:       "Noto Sans Bold 12";
}

entry {
    text-color:        @fg;
    placeholder-color: @muted;
    placeholder:       "Search...";
}

/* ── Results list ───────────────────────────── */
listview {
    background-color: transparent;
    spacing:          4px;
    lines:            8;
    columns:          1;
    fixed-height:     false;
}

element {
    padding:          8px 12px;
    border-radius:    8px;
    background-color: transparent;
    orientation:      horizontal;
    spacing:          10px;
}

element selected {
    background-color: @pink;
    text-color:       @bg;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}

/* No selected → hover feel via element selected already */
element normal active {
    text-color: @green;
}
