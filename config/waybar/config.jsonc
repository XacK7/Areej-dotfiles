{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left":   ["custom/launcher", "sway/workspaces", "sway/window"],
    "modules-center": ["clock"],
    "modules-right":  ["custom/control-panel", "custom/notes", "custom/weather", "sway/language", "pulseaudio", "tray"],

    "custom/launcher": {
        "format":   "❀",
        "tooltip":  false,
        "on-click": "~/.config/waybar/launcher.sh"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/window": {
        "max-length": 50,
        "format": "  {title}",
        "tooltip": false
    },

    "custom/control-panel": {
        "format":   "⚙",
        "tooltip":  "Open control panel",
        "on-click": "$HOME/.config/control-panel/launch.sh"
    },

    "custom/notes": {
        "exec":           "~/.config/waybar/notes.sh",
        "return-type":    "json",
        "interval":       30,
        "on-click":       "~/.config/waybar/notes-list.sh",
        "on-click-right": "~/.config/waybar/notes-add.sh"
    },

    "custom/weather": {
        "exec":      "~/.config/waybar/weather.sh",
        "return-type": "json",
        "interval":  600,
        "on-click":  "xdg-open https://wttr.in/Djelfa"
    },

    "sway/language": {
        "format": "  {short}",
        "tooltip-format": "{long}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },

    "clock": {
        "format": "  {:%H:%M    %a %d %B}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
        "locale": "en_US.UTF-8",
        "timezone": "Africa/Algiers"
    },

    "pulseaudio": {
        "format":       "{icon}  {volume}%",
        "format-muted": "   muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "tray": {
        "spacing": 8,
        "icon-size": 18
    }
}
