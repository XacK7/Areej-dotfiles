# Backup files created by setup.sh
*.bak

# Claude Code project files
.claude/

# Editor and OS junk
.DS_Store
*~
*.swp

# Neovim plugin lockfile — gets auto-updated on plugin sync, not config
config/nvim/lazy-lock.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# Control-panel runtime state (now lives in ~/.local/state/control-panel)
# Defensive ignores in case stray writes ever land here again.
config/control-panel/backup/
config/control-panel/theme.current.json
config/control-panel/wallpaper.current
config/control-panel/wallpaper.dir
